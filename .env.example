# Server-side Supabase Edge Function secrets only.
# Keep false for a $0 deployment. R2 can bill for storage and requests above its allowances.
R2_UPLOADS_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=masheeds-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Generate a separate random value of at least 32 characters for the cleanup job.
R2_CLEANUP_TOKEN=
# Optional, one exact web origin such as https://music.example.com. Android can leave this empty.
R2_WEB_ORIGIN=
